---
import TopNav from '../components/TopNav.astro';
import '../styles/global.css';

const {
  title = 'Under-Utils',
  description = '面向 Java 21 / Spring Boot 项目的工程模式工具包',
  current = 'home',
  bodyClass = ''
} = Astro.props as {
  title?: string;
  description?: string;
  current?: string;
  bodyClass?: string;
};

const pageTitle = title === 'Under-Utils' ? title : `${title} | Under-Utils`;
const siteUrl = Astro.site ?? new URL('https://under-utils.howied.me');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL('/social-preview.png', siteUrl).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1180, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Under-Utils" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <TopNav current={current} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Under-Utils</strong>
        <span>MIT License</span>
        <span>Java 21 / Spring Boot 3.1.x</span>
      </div>
      <a href="https://central.sonatype.com/artifact/io.github.yexianglun-d/under-utils-starter" target="_blank" rel="noopener noreferrer">
        Maven Central
      </a>
    </footer>
    <script>
      import '../scripts/siteAnimations';
    </script>
  </body>
</html>
